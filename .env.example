# ── Customer demo build ──────────────────────────────────────────────────────
# Which brand this build wears. Unset (or "edify") = internal prototype:
# no branding overrides, no gate, demo controls visible.
# Set to "chagee" (see lib/demoConfig.ts) for the gated customer build.
NEXT_PUBLIC_DEMO_CUSTOMER=

# ── Passcode gate ────────────────────────────────────────────────────────────
# Ed's access code. /welcome shows a closed "get in touch" page; five quick
# clicks on "Powered by Edify" (bottom-right) reveal the code field. Leaving
# this UNSET disables the gate entirely (dev + internal build are never
# blocked).
DEMO_GATE_PASSCODE=
# Salt mixed into the gate cookie token. Any random string; change it to
# invalidate every existing session.
DEMO_GATE_SECRET=

# ── Mixpanel (analytics) ─────────────────────────────────────────────────────
# Project token for the DEDICATED demo project (not your production Edify one).
# Unset = analytics fully disabled.
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Ingestion host. Defaults to EU residency; set the US host for a US project.
# EU:  https://api-eu.mixpanel.com   US: https://api.mixpanel.com
NEXT_PUBLIC_MIXPANEL_API_HOST=
